# Copy to .env (never commit .env) and fill in.
# Without ANTHROPIC_API_KEY the assistant runs in offline (retrieval-only) mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto

# Base URL of the Spring Boot Network Fault Management API, e.g. http://localhost:8080
# Leave empty to use the built-in in-memory mock.
FAULT_API_URL=
